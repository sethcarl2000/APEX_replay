# Cuts for APEX production data
#

# coinc trigger
coinc_trigger		fEvtHdr.fEvtType==6
		
R_vdc_u1		R.vdc.u1.nhits>=2
R_vdc_v1		R.vdc.v1.nhits>=2
R_vdc_u2		R.vdc.u2.nhits>=2
R_vdc_v2		R.vdc.v2.nhits>=2

R_s2			Ndata.R.s2.lt>=1&&Ndata.R.s2.rt>=1

L_vdc_u1		L.vdc.u1.nhits>=2
L_vdc_v1		L.vdc.v1.nhits>=2
L_vdc_u2		L.vdc.u2.nhits>=2
L_vdc_v2		L.vdc.v2.nhits>=2

L_s2			Ndata.L.s2.lt>=1&&Ndata.L.s2.rt>=1