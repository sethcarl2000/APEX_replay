#!/bin/bash

#SBATCH --nodes 1
#SBATCH --partition production
#SBATCH --account halla
#SBATCH --ntasks 1
#SBATCH --cpus-per-task=4
#SBATCH --mem=3G
#SBATCH --gres=disk:2G
#SBATCH --time 600
#SBATCH --output=/volatile/halla/apex/full_replay/slurm/full-replay/%x.%a.%A.out
#SBATCH --error=/volatile/halla/apex/full_replay/slurm/full-replay/%x.%a.%A.err

# move to the scratch dir 
PATH_SCRATCH="/scratch/slurm/${SLURM_JOB_ID}" 

# check to make sure this directory exists
if [[ ! -d "${PATH_SCRATCH}" ]]
then
    echo "scratch directory does not exist! path: ${PATH_SCRATCH}" >&2 
    exit 1 
fi

cd ${PATH_SCRATCH}

path_tarball=${1}

echo "<${0}>: unpacking tarball: ${path_tarball}" 

# unpack the tarball of data / executables
tar -xzf ${path_tarball}


echo "<${0}>: done. directory contents:" 
ls -1 * 

# set up APEX env
echo "<${0}>: setting env"

source set_apex_replay_env.sh
echo "<${0}>: pwd: '$(pwd)'" 

OUTPUT_DIR="${PATH_APEX_VOLATILE}/production" 

# load the proper version of the analyzer
#module unload analyzer 
#module load analyzer/1.7.15 

echo "<${0}>: analyzer version:" 
analyzer --version

echo "<${0}>: root version:" 
root --version

echo "<${0}>: uname -a (OS info):"
uname -a



# check to make sure we have an 'array tasks' file 

PATH_TASK_LIST="array-tasks.csv"

if [[ ! -f "${PATH_TASK_LIST}" ]]
then    
    echo "Task file does not exist! expected rel. path: ${PATH_TASK_LIST}; directory contents: " >&2 
    ls -1 * >&2 
    exit 1 
fi

echo "<${0}>: Starting timestamp: $(date +'%Y.%m.%d %H:%M:%S')" 

# now, execute all tasks: 
echo "<${0}>: Executing task macro:"

analyzer -l -b -q "execute_array_task.C(\"${PATH_TASK_LIST}\", \"${OUTPUT_DIR}\")" 

echo "<${0}>: Done." 

echo "<${0}>: Ending timestamp: $(date +'%Y.%m.%d %H:%M:%S')" 

